---
/**
 * index.astro — Magic Tools homepage
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Hero from '@/components/home/Hero.astro';
import SearchBar from '@/components/home/SearchBar';
import CategoryGrid from '@/components/home/CategoryGrid.astro';
import PrivacySection from '@/components/home/PrivacySection.astro';
import FAQ from '@/components/home/FAQ.astro';
import ToastContainer from '@/components/common/Toast';
import { buildHomepageSchema, SITE_DESCRIPTION } from '@/utils/seo';

const schema = buildHomepageSchema();
---

<BaseLayout
  description={SITE_DESCRIPTION}
  schema={schema}
>
  <Header />
  <ToastContainer client:load />

  <main id="main-content" class="flex-1">
    <!-- Hero Section with integrated search -->
    <Hero />

    <!-- All Tools Grid by Category -->
    <CategoryGrid />

    <!-- Privacy & Security Architecture -->
    <PrivacySection />

    <!-- FAQ Accordion -->
    <FAQ />
  </main>

  <Footer />
</BaseLayout>
