---
/**
 * index.astro — Magic Tools homepage
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Hero from '@/components/home/Hero.astro';
import SearchBar from '@/components/home/SearchBar';
import CategoryGrid from '@/components/home/CategoryGrid.astro';
import PrivacySection from '@/components/home/PrivacySection.astro';
import FAQ from '@/components/home/FAQ.astro';
import ToastContainer from '@/components/common/Toast';
import { buildHomepageSchema, SITE_DESCRIPTION } from '@/utils/seo';

const schema = buildHomepageSchema();
---

<BaseLayout
  description={SITE_DESCRIPTION}
  schema={schema}
>
  <Header />
  <ToastContainer client:load />

  <main id="main-content" class="flex-1">
    <!-- Hero Section -->
    <Hero />

    <!-- Live Search Section -->
    <section class="py-8 sm:py-10 border-y border-neutral-200/80 dark:border-neutral-800/80 bg-white/60 dark:bg-neutral-900/60 glass" aria-label="Search tools">
      <div class="container">
        <SearchBar client:load />
      </div>
    </section>

    <!-- All Tools Grid by Category -->
    <CategoryGrid />

    <!-- Privacy & Security Architecture -->
    <PrivacySection />

    <!-- FAQ Accordion -->
    <FAQ />
  </main>

  <Footer />
</BaseLayout>
