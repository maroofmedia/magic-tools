---
/**
 * Footer.astro — Modern clean footer with elevated author attribution
 */
import { TOOLS } from '@/utils/tools-config';

const imageTools = TOOLS.filter(t => t.category === 'image').slice(0, 6);
const pdfTools = TOOLS.filter(t => t.category === 'pdf');
const year = new Date().getFullYear();
---

<footer class="border-t border-neutral-200 dark:border-neutral-800/80 bg-white dark:bg-neutral-900/60 transition-colors duration-200">
  <div class="container py-8 sm:py-10">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">

      <!-- Brand Column -->
      <div class="sm:col-span-2 lg:col-span-1 space-y-3">
        <a href="/" class="flex items-center gap-2 group" aria-label="Magic Tools">
          <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-brand-600 via-indigo-600 to-purple-600 flex items-center justify-center shadow-xs group-hover:scale-105 transition-all duration-200">
            <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18"/>
            </svg>
          </div>
          <span class="font-display font-bold text-neutral-900 dark:text-white text-lg tracking-tight">
            Magic<span class="text-brand-600 dark:text-brand-400">Tools</span>
          </span>
        </a>

        <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-sm">
          Free, private online file tools to compress, convert, and edit your images and PDFs directly in your browser without uploading to any server.
        </p>

        <div class="pt-1">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-medium bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800/40">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            100% Client-Side & Private
          </span>
        </div>
      </div>

      <!-- Image Tools Column -->
      <div>
        <h3 class="font-display font-semibold text-xs uppercase tracking-wider text-neutral-900 dark:text-white mb-3">
          Image Tools
        </h3>
        <ul class="space-y-1.5">
          {imageTools.map((tool) => (
            <li>
              <a
                href={`/tools/${tool.slug}`}
                class="text-xs text-neutral-600 dark:text-neutral-400 hover:text-brand-600 dark:hover:text-brand-400 transition-colors inline-flex items-center gap-1.5"
              >
                <span>{tool.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- PDF Tools Column -->
      <div>
        <h3 class="font-display font-semibold text-xs uppercase tracking-wider text-neutral-900 dark:text-white mb-3">
          PDF Tools
        </h3>
        <ul class="space-y-1.5">
          {pdfTools.map((tool) => (
            <li>
              <a
                href={`/tools/${tool.slug}`}
                class="text-xs text-neutral-600 dark:text-neutral-400 hover:text-brand-600 dark:hover:text-brand-400 transition-colors"
              >
                {tool.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Information Column -->
      <div>
        <h3 class="font-display font-semibold text-xs uppercase tracking-wider text-neutral-900 dark:text-white mb-3">
          Information
        </h3>
        <ul class="space-y-1.5">
          <li>
            <a href="/privacy" class="text-xs text-neutral-600 dark:text-neutral-400 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
              Privacy & Security
            </a>
          </li>
          <li>
            <a href="/#faq" class="text-xs text-neutral-600 dark:text-neutral-400 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
              FAQ
            </a>
          </li>
          <li>
            <a href="/#tools" class="text-xs text-neutral-600 dark:text-neutral-400 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
              All Tools
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Credits Bar -->
    <div class="mt-8 pt-5 border-t border-neutral-200/80 dark:border-neutral-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-neutral-500 dark:text-neutral-400">
      <p>
        © {year} <span class="font-semibold text-neutral-800 dark:text-neutral-200">Magic Tools</span>. Free client-side tools for photos & documents.
      </p>

      <!-- Styled Creator Badge -->
      <div>
        <a
          href="https://www.marooflone.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-neutral-100 hover:bg-brand-50 dark:bg-neutral-800/80 dark:hover:bg-neutral-800 border border-neutral-200/80 dark:border-neutral-700/80 text-xs text-neutral-600 dark:text-neutral-300 hover:text-brand-600 dark:hover:text-brand-400 shadow-2xs hover:shadow-xs transition-all duration-200 hover:-translate-y-0.5"
          aria-label="Portfolio of Maroof Lone"
        >
          <span class="flex items-center justify-center w-5 h-5 rounded-full bg-gradient-to-tr from-brand-600 via-indigo-600 to-purple-600 text-[10px] font-bold text-white shadow-2xs group-hover:scale-105 transition-transform">
            M
          </span>
          <span class="font-normal">
            Made by <strong class="font-semibold text-neutral-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">Maroof Lone</strong>
          </span>
          <svg class="w-3.5 h-3.5 text-neutral-400 group-hover:text-brand-500 group-hover:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
