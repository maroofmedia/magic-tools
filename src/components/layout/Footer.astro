---
/**
 * Footer.astro — Site footer
 */
import { TOOLS, CATEGORIES } from '@/utils/tools-config';

const imageTools = TOOLS.filter(t => t.category === 'image').slice(0, 5);
const pdfTools = TOOLS.filter(t => t.category === 'pdf').slice(0, 5);
const year = new Date().getFullYear();
---

<footer class="border-t border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900">
  <div class="container py-12 sm:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">

      <!-- Brand column -->
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-2.5 mb-4" aria-label="Magic Tools">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-brand-500 to-purple-600 flex items-center justify-center shadow">
            <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18"/>
            </svg>
          </div>
          <span class="font-bold text-neutral-900 dark:text-neutral-50">Browser<span class="text-brand-600 dark:text-brand-400">Tools</span></span>
        </a>
        <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">
          Free, open-source file utilities that work entirely in your browser. No upload, no cloud, 100% private.
        </p>
        <div class="flex items-center gap-2 mt-4">
          <span class="inline-flex items-center gap-1.5 text-xs font-medium text-green-700 dark:text-green-400 bg-green-50 dark:bg-green-950/40 border border-green-200 dark:border-green-800/50 px-2.5 py-1 rounded-full">
            <span class="w-1.5 h-1.5 rounded-full bg-green-500 inline-block animate-pulse"></span>
            100% Private
          </span>
        </div>
      </div>

      <!-- Image tools -->
      <div>
        <h3 class="text-sm font-semibold text-neutral-900 dark:text-neutral-100 mb-3">Image Tools</h3>
        <ul class="space-y-2">
          {imageTools.map((tool) => (
            <li>
              <a
                href={`/tools/${tool.slug}`}
                class="text-sm text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
              >
                {tool.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- PDF tools -->
      <div>
        <h3 class="text-sm font-semibold text-neutral-900 dark:text-neutral-100 mb-3">PDF Tools</h3>
        <ul class="space-y-2">
          {pdfTools.map((tool) => (
            <li>
              <a
                href={`/tools/${tool.slug}`}
                class="text-sm text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
              >
                {tool.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Info -->
      <div>
        <h3 class="text-sm font-semibold text-neutral-900 dark:text-neutral-100 mb-3">About</h3>
        <ul class="space-y-2">
          <li>
            <a href="/#privacy" class="text-sm text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">
              Privacy Policy
            </a>
          </li>
          <li>
            <a href="/#faq" class="text-sm text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">
              FAQ
            </a>
          </li>
          <li>
            <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="text-sm text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">
              GitHub ↗
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-8 border-t border-neutral-200 dark:border-neutral-800 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-neutral-400 dark:text-neutral-500">
        © {year} Magic Tools. Open source. Made with ♥ for privacy.
      </p>
      <p class="text-xs text-neutral-400 dark:text-neutral-500">
        No servers. No tracking. No uploads.
      </p>
    </div>
  </div>
</footer>
