---
/**
 * ToolIcon.astro — Vibrant, high-precision SVG icons for every tool (iLovePDF style)
 */
interface Props {
  slug: string;
  className?: string;
}

const { slug, className = 'w-10 h-10' } = Astro.props;
---

{slug === 'remove-metadata' && (
  <div class={`${className} rounded-xl bg-emerald-500/10 text-emerald-600 dark:bg-emerald-500/20 dark:text-emerald-400 flex items-center justify-center flex-shrink-0`}>
    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
      <path d="m9 12 2 2 4-4"/>
    </svg>
  </div>
)}

{slug === 'merge-pdf' && (
  <div class={`${className} rounded-xl bg-red-500/10 text-red-500 dark:bg-red-500/20 dark:text-red-400 flex items-center justify-center flex-shrink-0`}>
    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M8 3H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h4"/>
      <path d="M16 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
      <path d="M9 12h6"/>
      <path d="m12 9 3 3-3 3"/>
    </svg>
  </div>
)}

{slug === 'split-pdf' && (
  <div class={`${className} rounded-xl bg-orange-500/10 text-orange-500 dark:bg-orange-500/20 dark:text-orange-400 flex items-center justify-center flex-shrink-0`}>
    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14 2v4a2 2 0 0 0 2 2h4"/>
      <path d="M4 14V4a2 2 0 0 1 2-2h8l6 6v6"/>
      <line x1="2" y1="18" x2="22" y2="18" stroke-dasharray="3 3"/>
      <circle cx="6" cy="18" r="2" fill="currentColor"/>
      <circle cx="18" cy="18" r="2" fill="currentColor"/>
    </svg>
  </div>
)}

{slug === 'compress-pdf' && (
  <div class={`${className} rounded-xl bg-emerald-500/10 text-emerald-600 dark:bg-emerald-500/20 dark:text-emerald-400 flex items-center justify-center flex-shrink-0`}>
    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
      <polyline points="14 2 14 8 20 8"/>
      <path d="M12 18v-6"/>
      <path d="m9 15 3 3 3-3"/>
      <path d="M9 12h6"/>
    </svg>
  </div>
)}

{slug === 'pdf-to-images' && (
  <div class={`${className} rounded-xl bg-amber-500/10 text-amber-500 dark:bg-amber-500/20 dark:text-amber-400 flex items-center justify-center flex-shrink-0`}>
    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
      <polyline points="14 2 14 8 20 8"/>
      <circle cx="10" cy="13" r="1.5"/>
      <path d="m8 17 3-3 4 4"/>
    </svg>
  </div>
)}

{slug === 'compress-image' && (
  <div class={`${className} rounded-xl bg-purple-500/10 text-purple-600 dark:bg-purple-500/20 dark:text-purple-400 flex items-center justify-center flex-shrink-0`}>
    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect width="18" height="18" x="3" y="3" rx="3" ry="3"/>
      <circle cx="9" cy="9" r="2"/>
      <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
      <path d="M14 8v4m0 0-2-2m2 2 2-2"/>
    </svg>
  </div>
)}

{slug === 'image-to-pdf' && (
  <div class={`${className} rounded-xl bg-rose-500/10 text-rose-500 dark:bg-rose-500/20 dark:text-rose-400 flex items-center justify-center flex-shrink-0`}>
    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 16l4.586-4.586a2 2 0 0 1 2.828 0L16 16"/>
      <circle cx="8" cy="8" r="2"/>
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z"/>
      <path d="M14 2v6h6"/>
    </svg>
  </div>
)}

{slug === 'jpg-to-png' && (
  <div class={`${className} rounded-xl bg-blue-500/10 text-blue-500 dark:bg-blue-500/20 dark:text-blue-400 flex items-center justify-center flex-shrink-0`}>
    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect width="18" height="18" x="3" y="3" rx="3"/>
      <path d="m7 15 3-4 4 5 2-2 2 2"/>
      <path d="M10 7h4v4"/>
    </svg>
  </div>
)}

{slug === 'png-to-jpg' && (
  <div class={`${className} rounded-xl bg-amber-500/10 text-amber-600 dark:bg-amber-500/20 dark:text-amber-400 flex items-center justify-center flex-shrink-0`}>
    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect width="18" height="18" x="3" y="3" rx="3"/>
      <path d="M3 15l4-4a2 2 0 0 1 2.8 0L14 15"/>
      <path d="M14 14l1-1a2 2 0 0 1 2.8 0L21 16"/>
    </svg>
  </div>
)}

{slug === 'convert-to-webp' && (
  <div class={`${className} rounded-xl bg-emerald-500/10 text-emerald-500 dark:bg-emerald-500/20 dark:text-emerald-400 flex items-center justify-center flex-shrink-0`}>
    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>
    </svg>
  </div>
)}

{slug === 'webp-to-png' && (
  <div class={`${className} rounded-xl bg-cyan-500/10 text-cyan-600 dark:bg-cyan-500/20 dark:text-cyan-400 flex items-center justify-center flex-shrink-0`}>
    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect width="18" height="18" x="3" y="3" rx="3"/>
      <circle cx="8" cy="8" r="1.5"/>
      <path d="M21 16l-5-5-5 5"/>
      <path d="M11 16l-3-3-5 5"/>
    </svg>
  </div>
)}

{slug === 'webp-to-jpg' && (
  <div class={`${className} rounded-xl bg-indigo-500/10 text-indigo-500 dark:bg-indigo-500/20 dark:text-indigo-400 flex items-center justify-center flex-shrink-0`}>
    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect width="18" height="18" x="3" y="3" rx="3"/>
      <path d="M7 17l4-4 4 4"/>
      <path d="M15 13l2-2 4 4"/>
      <circle cx="9" cy="8" r="1.5"/>
    </svg>
  </div>
)}

{slug === 'convert-avif' && (
  <div class={`${className} rounded-xl bg-violet-500/10 text-violet-500 dark:bg-violet-500/20 dark:text-violet-400 flex items-center justify-center flex-shrink-0`}>
    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/>
      <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>
      <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/>
      <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>
    </svg>
  </div>
)}
