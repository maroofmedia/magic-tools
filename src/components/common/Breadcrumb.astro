---
/**
 * Breadcrumb.astro — Accessible breadcrumb navigation
 */
interface BreadcrumbItem {
  label: string;
  href?: string;
}
interface Props {
  items: BreadcrumbItem[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-1 text-sm text-neutral-500 dark:text-neutral-400">
    {items.map((item, idx) => {
      const isLast = idx === items.length - 1;
      return (
        <li class="flex items-center gap-1">
          {idx > 0 && (
            <svg class="w-3.5 h-3.5 text-neutral-400 dark:text-neutral-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          )}
          {isLast ? (
            <span class="text-neutral-900 dark:text-neutral-100 font-medium" aria-current="page">
              {item.label}
            </span>
          ) : (
            <a href={item.href} class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">
              {item.label}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>
