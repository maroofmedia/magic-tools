---
/**
 * PrivacySection.astro — Simple, friendly privacy & security explainer
 */
const simpleBenefits = [
  {
    icon: '🔒',
    title: 'Never Uploaded',
    description: 'Your files never leave your phone or computer. Everything stays on your device.',
  },
  {
    icon: '⚡',
    title: 'Fast & Instant',
    description: 'No waiting for files to upload or download from a server. Processing is immediate.',
  },
  {
    icon: '📱',
    title: 'Works on All Devices',
    description: 'Use it on your iPhone, Android, laptop, or desktop without installing any apps.',
  },
  {
    icon: '🆓',
    title: 'Free Forever',
    description: 'No account needed, no hidden fees, and no file quantity restrictions.',
  },
];

const simpleSteps = [
  {
    step: '1',
    title: 'Choose Your File',
    description: 'Select an image or PDF from your device.',
  },
  {
    step: '2',
    title: 'Instant Processing',
    description: 'Your browser modifies the file directly.',
  },
  {
    step: '3',
    title: 'Save to Device',
    description: 'Download your finished file with one click.',
  },
];
---

<section id="privacy" class="section-padding bg-neutral-50/70 dark:bg-neutral-950 text-neutral-900 dark:text-white relative overflow-hidden scroll-mt-14 border-y border-neutral-200/70 dark:border-neutral-800/80">
  <!-- Subtle ambient glow -->
  <div class="absolute top-0 right-1/4 w-72 h-72 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute bottom-0 left-1/4 w-72 h-72 bg-brand-500/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="container relative z-10">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-8 sm:mb-10">
      <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 mb-2.5 rounded-full bg-emerald-50 dark:bg-emerald-950/70 border border-emerald-200/80 dark:border-emerald-700/60 text-emerald-700 dark:text-emerald-300 text-xs font-medium">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span>Privacy & Security</span>
      </div>
      <h2 class="font-display text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-neutral-900 dark:text-white mb-2.5">
        Your files stay on <span class="text-emerald-600 dark:text-emerald-400">your device</span>.
      </h2>
      <p class="text-neutral-600 dark:text-neutral-400 text-xs sm:text-sm leading-relaxed">
        Unlike other tools that upload your documents to the cloud, Magic Tools processes your files directly in your web browser.
      </p>
    </div>

    <!-- 3 Simple Steps -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3.5 mb-8">
      {simpleSteps.map(({ step, title, description }) => (
        <div class="p-4 rounded-xl bg-white dark:bg-neutral-900/80 border border-neutral-200/80 dark:border-neutral-800/80 shadow-2xs flex items-start gap-3">
          <span class="w-7 h-7 rounded-lg bg-emerald-100 dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-400 font-bold text-sm flex items-center justify-center flex-shrink-0">
            {step}
          </span>
          <div>
            <h3 class="font-display text-sm font-bold text-neutral-900 dark:text-white">{title}</h3>
            <p class="text-xs text-neutral-600 dark:text-neutral-400 mt-0.5 leading-relaxed">{description}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Simple Benefits Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
      {simpleBenefits.map(({ icon, title, description }) => (
        <div class="p-4 rounded-xl bg-white dark:bg-neutral-900/80 border border-neutral-200/80 dark:border-neutral-800/80 hover:border-emerald-300 dark:hover:border-emerald-700 shadow-2xs transition-all duration-150">
          <div class="text-2xl mb-2" aria-hidden="true">{icon}</div>
          <h3 class="font-display text-sm font-bold text-neutral-900 dark:text-white mb-1">{title}</h3>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">{description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
