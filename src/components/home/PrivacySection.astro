---
/**
 * PrivacySection.astro — Privacy & trust section
 */
const features = [
  {
    icon: '🔒',
    title: 'Files Never Leave Your Device',
    description:
      'All processing happens locally using your browser\'s built-in JavaScript engine. No file is ever transmitted to any server.',
  },
  {
    icon: '📡',
    title: 'No Network Required',
    description:
      'Once the page loads, most tools work completely offline. You can even disconnect from the internet.',
  },
  {
    icon: '🗑️',
    title: 'Files Are Discarded Instantly',
    description:
      'Files are loaded into temporary memory, processed, and immediately released. Nothing is written to disk or persisted.',
  },
  {
    icon: '🚫',
    title: 'No Tracking. No Analytics. No Ads.',
    description:
      'We do not track you, show ads, or collect telemetry. The source code is open so you can verify it yourself.',
  },
  {
    icon: '✅',
    title: 'Open Source',
    description:
      'Every line of processing code is open source and auditable on GitHub. Trust, but verify.',
  },
  {
    icon: '🌍',
    title: 'Works Everywhere',
    description:
      'Any modern browser on desktop, tablet, or mobile. No installation. No plugins. No app store.',
  },
];
---

<section id="privacy" class="section-padding bg-neutral-900 dark:bg-neutral-950 scroll-mt-20">
  <div class="container">
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 mb-4 rounded-full bg-green-900/40 border border-green-700/50 text-green-400 text-sm font-medium">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
        </svg>
        Privacy-First Design
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">
        Your files stay on <span class="gradient-text">your device</span>
      </h2>
      <p class="text-neutral-400 max-w-2xl mx-auto text-lg">
        We've built BrowserTools from the ground up with one principle: process everything locally. Here's exactly how we protect your privacy.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 stagger-children">
      {features.map(({ icon, title, description }, i) => (
        <div
          class="p-6 rounded-2xl bg-white/5 border border-white/10 hover:bg-white/8 hover:border-white/20 transition-all duration-200 animate-fade-in-up"
          style={`animation-delay: ${i * 80}ms`}
        >
          <div class="text-3xl mb-4" aria-hidden="true">{icon}</div>
          <h3 class="text-base font-semibold text-white mb-2">{title}</h3>
          <p class="text-sm text-neutral-400 leading-relaxed">{description}</p>
        </div>
      ))}
    </div>

    <!-- Technical note -->
    <div class="mt-10 p-5 rounded-2xl bg-green-900/20 border border-green-700/30 text-center">
      <p class="text-sm text-green-300">
        <strong class="text-green-200">Technical note:</strong> Processing uses the
        <code class="font-mono bg-green-900/40 px-1.5 py-0.5 rounded text-green-200">File API</code>,
        <code class="font-mono bg-green-900/40 px-1.5 py-0.5 rounded text-green-200">Canvas API</code>, and
        <code class="font-mono bg-green-900/40 px-1.5 py-0.5 rounded text-green-200">Web Workers</code> — all standard browser APIs that run entirely client-side.
        Open your browser's Network inspector to confirm: zero file uploads.
      </p>
    </div>
  </div>
</section>
