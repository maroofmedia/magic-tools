---
/**
 * PrivacySection.astro — Clean, professional privacy assurance
 */
const features = [
  {
    icon: '🔒',
    title: 'Zero Server Uploads',
    desc: 'All file processing runs locally in your web browser. Your files never leave your device.',
  },
  {
    icon: '⚡',
    title: 'Instant Execution',
    desc: 'No upload or download delays. Files are processed immediately at native device speed.',
  },
  {
    icon: '🛡️',
    title: 'No Accounts or Tracking',
    desc: 'Completely free to use with no account required, no cookies, and no data collection.',
  },
];
---

<section id="privacy" class="py-10 sm:py-14 border-y border-neutral-200/80 dark:border-neutral-800/80 bg-neutral-100/50 dark:bg-neutral-900/40 scroll-mt-14">
  <div class="container max-w-4xl">
    <div class="text-center mb-8">
      <h2 class="font-display text-xl sm:text-2xl font-bold text-neutral-900 dark:text-white">
        Built for privacy and speed
      </h2>
      <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 mt-1 max-w-lg mx-auto">
        Unlike traditional online file converters that upload documents to remote servers, Magic Tools operates 100% on your machine.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {features.map((f) => (
        <div class="p-4 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200/80 dark:border-neutral-800">
          <span class="text-xl mb-2 block">{f.icon}</span>
          <h3 class="font-display font-semibold text-sm text-neutral-900 dark:text-white mb-1">
            {f.title}
          </h3>
          <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed">
            {f.desc}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
