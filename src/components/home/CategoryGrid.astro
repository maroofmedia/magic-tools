---
/**
 * CategoryGrid.astro — Clean, elegant tool grid by category
 */
import ToolCard from './ToolCard.astro';
import { TOOLS } from '@/utils/tools-config';

const imageTools = TOOLS.filter((t) => t.category === 'image');
const pdfTools = TOOLS.filter((t) => t.category === 'pdf');
const spreadsheetTools = TOOLS.filter((t) => t.category === 'spreadsheet');
---

<section id="tools" class="py-8 sm:py-12 scroll-mt-14">
  <div class="container space-y-10 sm:space-y-12">

    <!-- Image Tools -->
    <div id="image" class="scroll-mt-20">
      <div class="pb-3 mb-4 border-b border-neutral-200/80 dark:border-neutral-800/80">
        <h2 class="font-display text-lg sm:text-xl font-bold text-neutral-900 dark:text-white">
          Image Tools
        </h2>
        <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5">
          Compress, convert, and format photos
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3 sm:gap-3.5">
        {imageTools.map((tool) => (
          <ToolCard tool={tool} animate={false} />
        ))}
      </div>
    </div>

    <!-- PDF Tools -->
    <div id="pdf" class="scroll-mt-20">
      <div class="pb-3 mb-4 border-b border-neutral-200/80 dark:border-neutral-800/80">
        <h2 class="font-display text-lg sm:text-xl font-bold text-neutral-900 dark:text-white">
          PDF Tools
        </h2>
        <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5">
          Merge, split, compress, and convert PDF documents
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3 sm:gap-3.5">
        {pdfTools.map((tool) => (
          <ToolCard tool={tool} animate={false} />
        ))}
      </div>
    </div>

    <!-- Spreadsheet Tools -->
    {spreadsheetTools.length > 0 && (
      <div id="spreadsheet" class="scroll-mt-20">
        <div class="pb-3 mb-4 border-b border-neutral-200/80 dark:border-neutral-800/80">
          <h2 class="font-display text-lg sm:text-xl font-bold text-neutral-900 dark:text-white">
            Spreadsheet Tools
          </h2>
          <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5">
            View, edit, track changes, and convert Excel, CSV, TSV & Google Sheets online
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3 sm:gap-3.5">
          {spreadsheetTools.map((tool) => (
            <ToolCard tool={tool} animate={false} />
          ))}
        </div>
      </div>
    )}

  </div>
</section>
