---
/**
 * FAQ.astro — Frequently asked questions accordion with simple language
 */
const faqs = [
  {
    q: 'Is Magic Tools completely free?',
    a: 'Yes, all tools are 100% free to use with no hidden subscriptions, watermarks, or usage limits.',
  },
  {
    q: 'How does it edit files without uploading them?',
    a: 'The tools run directly inside your web browser. Your files stay on your device the entire time and are never sent across the internet.',
  },
  {
    q: 'Does it work on phones and computers?',
    a: 'Yes! It works smoothly on iPhone, Android, Mac, Windows, and Linux on any modern browser.',
  },
  {
    q: 'Is there any file size limit?',
    a: 'You can process files up to 50 MB for images and 100 MB for PDFs, which easily covers standard everyday photos and documents.',
  },
  {
    q: 'Can I use the tools when offline?',
    a: 'Yes. Once this website is loaded in your browser tab, you can disconnect your internet and continue editing your files.',
  },
  {
    q: 'What is WebP and why should I use it?',
    a: 'WebP is a modern image format that makes photos 30% smaller than regular JPGs with the exact same visual quality, saving storage space and loading faster.',
  },
];
---

<section id="faq" class="section-padding scroll-mt-14">
  <div class="container">
    <div class="text-center max-w-xl mx-auto mb-6 sm:mb-8">
      <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md bg-neutral-100 dark:bg-neutral-800 text-xs font-medium text-neutral-600 dark:text-neutral-300 mb-2">
        Help & Questions
      </div>
      <h2 class="font-display text-2xl sm:text-3xl font-bold text-neutral-900 dark:text-white">
        Frequently Asked Questions
      </h2>
      <p class="text-neutral-600 dark:text-neutral-400 mt-1 text-xs sm:text-sm">
        Quick answers to common questions about using Magic Tools.
      </p>
    </div>

    <div class="max-w-2xl mx-auto space-y-2.5">
      {faqs.map(({ q, a }, idx) => (
        <details class="group p-3.5 sm:p-4 rounded-xl border border-neutral-200/90 dark:border-neutral-800 bg-white dark:bg-neutral-900/90 transition-colors shadow-2xs open:border-brand-400 dark:open:border-brand-700" open={idx === 0}>
          <summary class="flex items-center justify-between gap-3 cursor-pointer list-none select-none font-display font-semibold text-sm sm:text-base text-neutral-900 dark:text-neutral-100 group-open:text-brand-600 dark:group-open:text-brand-400 transition-colors">
            <span>{q}</span>
            <span class="w-6 h-6 rounded-lg bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center text-neutral-500 group-open:bg-brand-50 dark:group-open:bg-brand-950 group-open:text-brand-600 transition-all flex-shrink-0">
              <svg
                class="w-3.5 h-3.5 transition-transform duration-150 group-open:rotate-180"
                fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </span>
          </summary>
          <div class="mt-2.5 pt-2 border-t border-neutral-100 dark:border-neutral-800/60 text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed font-normal">
            {a}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
