---
/**
 * FAQ.astro — Frequently asked questions accordion
 */
const faqs = [
  {
    q: 'Are all 14 tools really 100% free?',
    a: 'Yes, Magic Tools is free forever with no hidden paywalls, premium tiers, or file quantity limits.',
  },
  {
    q: 'How does in-browser file processing work?',
    a: 'Modern browsers include built-in engines for Canvas rendering, WebAssembly, and Web Workers. We run the file processing code directly within your browser’s isolated sandbox. Your files never get uploaded to any server or cloud database.',
  },
  {
    q: 'Which browsers are supported?',
    a: 'All modern browsers on desktop and mobile: Google Chrome, Mozilla Firefox, Apple Safari, Microsoft Edge, Brave, and Opera. No plugins or downloads required.',
  },
  {
    q: 'Are there any file size limits?',
    a: 'Because files are processed in your device’s RAM memory, generous safety limits are set (50 MB for images, 100 MB for PDFs) to ensure smooth performance on mobile and desktop devices alike.',
  },
  {
    q: 'Can I use these tools completely offline?',
    a: 'Yes! Once the page is loaded, you can disconnect your internet and continue compressing, merging, cropping, and converting files.',
  },
  {
    q: 'What is WebP / AVIF and why should I convert?',
    a: 'WebP and AVIF are next-generation image formats that compress images up to 30% to 50% smaller than standard JPEGs without visible loss in quality, drastically speeding up websites and reducing storage.',
  },
];
---

<section id="faq" class="section-padding scroll-mt-16">
  <div class="container">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-neutral-100 dark:bg-neutral-800 text-xs font-semibold text-neutral-600 dark:text-neutral-300 mb-3">
        Got Questions?
      </div>
      <h2 class="font-display text-3xl sm:text-4xl font-bold text-neutral-900 dark:text-white">
        Frequently Asked Questions
      </h2>
      <p class="text-neutral-600 dark:text-neutral-400 mt-2 text-sm sm:text-base">
        Everything you need to know about how Magic Tools handles your files.
      </p>
    </div>

    <div class="max-w-3xl mx-auto space-y-3">
      {faqs.map(({ q, a }, idx) => (
        <details class="group p-5 rounded-2xl border border-neutral-200/90 dark:border-neutral-800 bg-white dark:bg-neutral-900/90 transition-colors shadow-2xs open:border-brand-300 dark:open:border-brand-800" open={idx === 0}>
          <summary class="flex items-center justify-between gap-4 cursor-pointer list-none select-none font-display font-semibold text-base sm:text-lg text-neutral-900 dark:text-neutral-100 group-open:text-brand-600 dark:group-open:text-brand-400 transition-colors">
            <span>{q}</span>
            <span class="w-7 h-7 rounded-xl bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center text-neutral-500 group-open:bg-brand-50 dark:group-open:bg-brand-950 group-open:text-brand-600 transition-all flex-shrink-0">
              <svg
                class="w-4 h-4 transition-transform duration-200 group-open:rotate-180"
                fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </span>
          </summary>
          <div class="mt-3.5 pt-3 border-t border-neutral-100 dark:border-neutral-800/60 text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed font-normal">
            {a}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
