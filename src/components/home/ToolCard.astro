---
/**
 * ToolCard.astro — Redesigned tool card for the homepage & category grid
 */
import type { ToolConfig } from '@/types/index';

interface Props {
  tool: ToolConfig;
  animate?: boolean;
  delay?: number;
}
const { tool, animate = true, delay = 0 } = Astro.props;

const categoryBadge = tool.category === 'image'
  ? 'bg-purple-50 dark:bg-purple-950/40 text-purple-700 dark:text-purple-300 border-purple-200/60 dark:border-purple-800/40'
  : 'bg-blue-50 dark:bg-blue-950/40 text-blue-700 dark:text-blue-300 border-blue-200/60 dark:border-blue-800/40';
---

<a
  href={tool.comingSoon ? undefined : `/tools/${tool.slug}`}
  aria-label={`${tool.name} — ${tool.description}`}
  class:list={[
    'group relative flex flex-col p-4 sm:p-4.5 rounded-xl border transition-all duration-150 ease-out',
    'bg-white dark:bg-neutral-900/90 border-neutral-200/90 dark:border-neutral-800/80',
    'hover:border-brand-400/80 dark:hover:border-brand-500/40',
    'card-hover',
    animate && 'animate-fade-in-up',
    tool.comingSoon && 'opacity-60 cursor-not-allowed pointer-events-none',
  ]}
  style={delay ? `animation-delay: ${delay}ms` : undefined}
>
  <!-- Top row: Icon + Feature Badge -->
  <div class="flex items-center justify-between gap-2 mb-2">
    <div class="w-9 h-9 rounded-lg bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center text-lg shadow-2xs group-hover:scale-105 transition-transform duration-150">
      <span role="img" aria-label={tool.name}>{tool.icon}</span>
    </div>
    {tool.featured && (
      <span class="text-[9px] uppercase tracking-wider font-bold px-2 py-0.5 rounded-full bg-amber-50 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300 border border-amber-200/60 dark:border-amber-800/50">
        Popular
      </span>
    )}
  </div>

  <!-- Content -->
  <h3 class="font-display font-semibold text-sm sm:text-base text-neutral-900 dark:text-neutral-100 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors leading-snug">
    {tool.name}
  </h3>
  <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed flex-1 font-normal">
    {tool.description}
  </p>

  <!-- Bottom Details & Launch Arrow -->
  <div class="mt-3.5 pt-2.5 border-t border-neutral-100 dark:border-neutral-800/60 flex items-center justify-between">
    <div class="flex items-center gap-1 flex-wrap">
      {tool.acceptedExtensions.slice(0, 3).map((ext) => (
        <span class="text-[10px] font-mono font-medium px-1.5 py-0.2 rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400">
          {ext}
        </span>
      ))}
      {tool.acceptedExtensions.length > 3 && (
        <span class="text-[9px] font-mono text-neutral-400 dark:text-neutral-500">
          +{tool.acceptedExtensions.length - 3}
        </span>
      )}
    </div>

    <div class="flex items-center gap-0.5 text-xs font-semibold text-neutral-400 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
      <span class="text-[11px] font-medium hidden group-hover:inline">Open</span>
      <svg class="w-3.5 h-3.5 transform group-hover:translate-x-0.5 transition-transform duration-150" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </div>
  </div>
</a>
