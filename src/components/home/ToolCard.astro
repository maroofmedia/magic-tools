---
/**
 * ToolCard.astro — iLovePDF-inspired clean, vibrant tool card
 */
import ToolIcon from '@/components/common/ToolIcon.astro';
import type { ToolConfig } from '@/types/index';

interface Props {
  tool: ToolConfig;
  animate?: boolean;
  delay?: number;
}
const { tool } = Astro.props;
---

<a
  href={`/tools/${tool.slug}`}
  class="group p-5 rounded-2xl border border-neutral-200/90 dark:border-neutral-800 bg-white dark:bg-neutral-900/90 hover:border-brand-500/80 dark:hover:border-brand-400 hover:shadow-lg hover:-translate-y-1 transition-all duration-200 flex flex-col justify-between"
>
  <div>
    <div class="mb-4">
      <ToolIcon slug={tool.slug} className="w-12 h-12" />
    </div>

    <h3 class="font-display font-bold text-base sm:text-lg text-neutral-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
      {tool.name}
    </h3>

    <p class="text-xs sm:text-sm text-neutral-500 dark:text-neutral-400 mt-1.5 leading-relaxed font-normal">
      {tool.description}
    </p>
  </div>
</a>
