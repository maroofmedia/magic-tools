---
/**
 * Hero.astro — Homepage Hero section with modern aesthetics & quick tool tags
 */
const quickTools = [
  { name: 'Compress Image', href: '/tools/compress-image', icon: '🗜️' },
  { name: 'Merge PDF', href: '/tools/merge-pdf', icon: '📋' },
  { name: 'Crop Photo', href: '/tools/crop-image', icon: '✂️' },
  { name: 'JPG to PNG', href: '/tools/jpg-to-png', icon: '🖼️' },
  { name: 'PDF to Images', href: '/tools/pdf-to-images', icon: '📷' },
  { name: 'Convert WebP', href: '/tools/convert-to-webp', icon: '⚡' },
];
---

<section class="relative overflow-hidden pt-24 pb-12 sm:pt-32 sm:pb-16 lg:pb-20">
  <!-- Ambient background glow mesh -->
  <div class="absolute inset-0 -z-10 pointer-events-none overflow-hidden" aria-hidden="true">
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[650px] sm:w-[850px] h-[450px] bg-gradient-to-tr from-brand-500/20 via-purple-500/15 to-pink-500/10 dark:from-brand-500/15 dark:via-purple-500/10 dark:to-indigo-500/5 rounded-full blur-[100px]"></div>
    <div class="absolute top-60 -left-20 w-72 h-72 bg-blue-400/10 dark:bg-blue-600/5 rounded-full blur-3xl"></div>
    <div class="absolute top-60 -right-20 w-72 h-72 bg-purple-400/10 dark:bg-purple-600/5 rounded-full blur-3xl"></div>
  </div>

  <div class="container text-center relative z-10">
    <!-- Top Privacy Badge -->
    <div class="animate-fade-in inline-flex items-center gap-2 px-3.5 py-1.5 mb-6 rounded-full bg-white/80 dark:bg-neutral-900/80 border border-neutral-200/90 dark:border-neutral-800/90 shadow-sm text-xs font-semibold text-neutral-800 dark:text-neutral-200 glass">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
      </span>
      <span>100% Client-Side Processing</span>
      <span class="text-neutral-300 dark:text-neutral-700">•</span>
      <span class="text-neutral-500 dark:text-neutral-400 font-normal">Zero Files Uploaded</span>
    </div>

    <!-- Main Headline with Jost font -->
    <h1 class="animate-fade-in-up font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight text-neutral-900 dark:text-white leading-[1.08] max-w-4xl mx-auto mb-6">
      Powerful file utilities,<br class="hidden sm:inline" />
      <span class="gradient-text">running purely in your browser.</span>
    </h1>

    <!-- Subtitle with Inter font -->
    <p class="animate-fade-in-up text-base sm:text-lg md:text-xl text-neutral-600 dark:text-neutral-400 max-w-2xl mx-auto mb-8 sm:mb-10 leading-relaxed font-normal">
      Compress, convert, crop, and manipulate image & PDF files with lightning speed.
      No accounts, no upload limits, and <strong class="text-neutral-900 dark:text-neutral-200 font-semibold">100% data privacy</strong>.
    </p>

    <!-- CTAs -->
    <div class="animate-fade-in-up flex flex-wrap items-center justify-center gap-3.5 mb-10">
      <a
        href="#tools"
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-semibold text-sm shadow-lg shadow-brand-500/25 hover:shadow-brand-500/35 hover:-translate-y-0.5 transition-all duration-200"
      >
        <span>Explore All 14 Tools</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </a>
      <a
        href="/privacy"
        class="inline-flex items-center gap-2 px-5 py-3.5 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 text-neutral-700 dark:text-neutral-300 hover:text-neutral-900 dark:hover:text-white hover:bg-neutral-50 dark:hover:bg-neutral-800/80 font-semibold text-sm shadow-sm transition-all duration-200"
      >
        <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
        </svg>
        <span>How Privacy Works</span>
      </a>
    </div>

    <!-- Quick Tool Pills for Fast Mobile & Desktop Access -->
    <div class="animate-fade-in-up flex flex-wrap items-center justify-center gap-2 max-w-3xl mx-auto pt-2">
      <span class="text-xs font-semibold text-neutral-400 dark:text-neutral-500 mr-1 uppercase tracking-wider">Quick Jump:</span>
      {quickTools.map((t) => (
        <a
          href={t.href}
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/70 dark:bg-neutral-900/70 hover:bg-white dark:hover:bg-neutral-800 border border-neutral-200/80 dark:border-neutral-800/80 text-xs font-medium text-neutral-700 dark:text-neutral-300 hover:text-brand-600 dark:hover:text-brand-400 shadow-2xs hover:shadow-xs transition-all duration-150"
        >
          <span class="text-sm">{t.icon}</span>
          <span>{t.name}</span>
        </a>
      ))}
    </div>

    <!-- Trust Stats Grid -->
    <div class="mt-14 pt-10 border-t border-neutral-200/60 dark:border-neutral-800/60 grid grid-cols-2 md:grid-cols-4 gap-6 max-w-4xl mx-auto">
      <div class="p-3">
        <div class="font-display text-2xl sm:text-3xl font-bold text-neutral-900 dark:text-white">0 MB</div>
        <div class="text-xs text-neutral-500 dark:text-neutral-400 mt-1 font-medium">Server Data Uploaded</div>
      </div>
      <div class="p-3">
        <div class="font-display text-2xl sm:text-3xl font-bold text-neutral-900 dark:text-white">&lt; 100ms</div>
        <div class="text-xs text-neutral-500 dark:text-neutral-400 mt-1 font-medium">Instant Local Engine</div>
      </div>
      <div class="p-3">
        <div class="font-display text-2xl sm:text-3xl font-bold text-neutral-900 dark:text-white">100%</div>
        <div class="text-xs text-neutral-500 dark:text-neutral-400 mt-1 font-medium">Private & Offline Ready</div>
      </div>
      <div class="p-3">
        <div class="font-display text-2xl sm:text-3xl font-bold text-neutral-900 dark:text-white">14 Tools</div>
        <div class="text-xs text-neutral-500 dark:text-neutral-400 mt-1 font-medium">Free Forever</div>
      </div>
    </div>
  </div>
</section>
