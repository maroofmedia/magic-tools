---
/**
 * Hero.astro — Vibrant homepage hero with integrated search and quick jump pills
 */
import SearchBar from './SearchBar';

const quickTools = [
  { name: 'Compress Image', href: '/tools/compress-image', icon: '🗜️' },
  { name: 'Compress PDF', href: '/tools/compress-pdf', icon: '🗜️' },
  { name: 'Image to PDF', href: '/tools/image-to-pdf', icon: '📄' },
];
---

<section class="relative pt-20 pb-10 sm:pt-24 sm:pb-14 border-b border-neutral-200/80 dark:border-neutral-800/80 bg-gradient-to-b from-brand-50/50 via-purple-50/20 to-white dark:from-brand-950/25 dark:via-purple-950/15 dark:to-neutral-950 overflow-hidden">
  <!-- Colorful Ambient Glow Accents -->
  <div class="absolute inset-0 -z-10 pointer-events-none overflow-hidden" aria-hidden="true">
    <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[600px] sm:w-[850px] h-[350px] bg-gradient-to-tr from-brand-500/20 via-purple-500/15 to-pink-500/15 dark:from-brand-500/15 dark:via-purple-500/15 dark:to-indigo-500/15 rounded-full blur-[90px]"></div>
  </div>

  <div class="container text-center max-w-3xl relative z-10">
    <!-- Top badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1 mb-4 rounded-full bg-white/90 dark:bg-neutral-900/90 border border-neutral-200/90 dark:border-neutral-800 shadow-2xs text-xs font-medium text-neutral-700 dark:text-neutral-300 glass">
      <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span>100% Free &amp; Client-Side File Tools</span>
    </div>

    <!-- Main Headline with Jost font & colorful gradient -->
    <h1 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-neutral-900 dark:text-white leading-[1.15] mb-3">
      Every tool you need for <br class="hidden sm:inline" />
      <span class="gradient-text">PDFs &amp; images</span> in one place
    </h1>

    <!-- Subtitle -->
    <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 max-w-xl mx-auto mb-6 leading-relaxed">
      Merge, split, compress, and convert your files directly in your browser. Fast, private, and no files uploaded to any server.
    </p>

    <!-- Integrated Search Bar -->
    <div class="max-w-xl mx-auto mb-4">
      <SearchBar client:load />
    </div>

    <!-- Quick Popular Pills -->
    <div class="flex flex-wrap items-center justify-center gap-1.5 text-xs">
      <span class="text-neutral-400 dark:text-neutral-500 mr-1 font-medium">Quick jump:</span>
      {quickTools.map((t) => (
        <a
          href={t.href}
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/90 dark:bg-neutral-900/90 hover:bg-white dark:hover:bg-neutral-800 border border-neutral-200/80 dark:border-neutral-800 text-neutral-700 dark:text-neutral-300 font-medium transition-colors text-xs shadow-2xs"
        >
          <span>{t.icon}</span>
          <span>{t.name}</span>
        </a>
      ))}
    </div>
  </div>
</section>
