---
/**
 * ToolLayout.astro
 * Layout wrapper for individual tool pages.
 */
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Breadcrumb from '@/components/common/Breadcrumb.astro';
import { buildToolSchema, SITE_URL } from '@/utils/seo';
import type { ToolConfig } from '@/types/index';

interface Props {
  tool: ToolConfig;
}

const { tool } = Astro.props;

const schema = buildToolSchema({
  name: tool.name,
  description: tool.longDescription,
  url: `${SITE_URL}/tools/${tool.slug}`,
  breadcrumbs: [
    { name: 'Home', url: SITE_URL },
    { name: 'Tools', url: `${SITE_URL}/#tools` },
    { name: tool.name, url: `${SITE_URL}/tools/${tool.slug}` },
  ],
});

const categoryLabel = tool.category === 'image' ? 'Image Tools' : 'PDF Tools';
---

<BaseLayout
  title={tool.name}
  description={tool.metaDescription}
  canonical={`${SITE_URL}/tools/${tool.slug}`}
  schema={schema}
>
  <Header />

  <main id="main-content" class="min-h-screen pt-16">
    <!-- Breadcrumb -->
    <div class="border-b border-neutral-200 dark:border-neutral-800">
      <div class="container py-3">
        <Breadcrumb
          items={[
            { label: 'Home', href: '/' },
            { label: categoryLabel, href: `/#${tool.category}` },
            { label: tool.name },
          ]}
        />
      </div>
    </div>

    <!-- Tool header -->
    <div class="border-b border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900">
      <div class="container py-8 sm:py-10">
        <div class="flex items-start gap-4">
          <div class="text-4xl sm:text-5xl" role="img" aria-label={tool.name}>
            {tool.icon}
          </div>
          <div>
            <h1 class="text-2xl sm:text-3xl font-bold text-neutral-900 dark:text-neutral-50">
              {tool.name}
            </h1>
            <p class="mt-1.5 text-neutral-600 dark:text-neutral-400 max-w-2xl">
              {tool.longDescription}
            </p>
            <!-- Accepted formats badge list -->
            <div class="flex flex-wrap gap-1.5 mt-3">
              {tool.acceptedExtensions.map((ext) => (
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-mono font-medium bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400">
                  {ext}
                </span>
              ))}
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-brand-50 dark:bg-brand-950 text-brand-600 dark:text-brand-400">
                Max {tool.maxSizeMB} MB
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Tool body (Preact island injected here) -->
    <div class="container py-8 sm:py-10">
      <slot />
    </div>

    <!-- Privacy notice -->
    <div class="container pb-10">
      <div class="flex items-center gap-3 p-4 rounded-xl bg-green-50 dark:bg-green-950/30 border border-green-200 dark:border-green-800/50 text-sm text-green-800 dark:text-green-300">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
        </svg>
        <p>
          <strong>100% Private.</strong> Your files are processed entirely in your browser.
          They are never uploaded to any server.
        </p>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
