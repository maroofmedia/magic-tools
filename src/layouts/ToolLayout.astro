---
/**
 * ToolLayout.astro — Layout wrapper for individual tool pages
 */
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Breadcrumb from '@/components/common/Breadcrumb.astro';
import { buildToolSchema, SITE_URL } from '@/utils/seo';
import type { ToolConfig } from '@/types/index';

interface Props {
  tool: ToolConfig;
}

const { tool } = Astro.props;

const schema = buildToolSchema({
  name: tool.name,
  description: tool.longDescription,
  url: `${SITE_URL}/tools/${tool.slug}`,
  breadcrumbs: [
    { name: 'Home', url: SITE_URL },
    { name: 'Tools', url: `${SITE_URL}/#tools` },
    { name: tool.name, url: `${SITE_URL}/tools/${tool.slug}` },
  ],
});

const categoryLabel = tool.category === 'image' ? 'Image Tools' : 'PDF Tools';
---

<BaseLayout
  title={tool.name}
  description={tool.metaDescription}
  canonical={`${SITE_URL}/tools/${tool.slug}`}
  schema={schema}
>
  <Header />

  <main id="main-content" class="min-h-screen pt-16 flex-1 flex flex-col">
    <!-- Breadcrumb bar -->
    <div class="border-b border-neutral-200/80 dark:border-neutral-800/80 bg-white/50 dark:bg-neutral-900/50 glass">
      <div class="container py-2.5">
        <Breadcrumb
          items={[
            { label: 'Home', href: '/' },
            { label: categoryLabel, href: `/#${tool.category}` },
            { label: tool.name },
          ]}
        />
      </div>
    </div>

    <!-- Tool Header Banner -->
    <div class="border-b border-neutral-200/80 dark:border-neutral-800/80 bg-white/80 dark:bg-neutral-900/80">
      <div class="container py-8 sm:py-10">
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-5 sm:gap-6">
          <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center text-4xl sm:text-5xl shadow-sm flex-shrink-0" role="img" aria-label={tool.name}>
            {tool.icon}
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2 mb-1.5">
              <span class={`text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-md ${tool.category === 'image' ? 'bg-purple-50 dark:bg-purple-950/60 text-purple-700 dark:text-purple-300 border border-purple-200/60 dark:border-purple-800/50' : 'bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 border border-blue-200/60 dark:border-blue-800/50'}`}>
                {tool.category} utility
              </span>
              <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-md bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800/50">
                100% Client-Side
              </span>
            </div>

            <h1 class="font-display text-2xl sm:text-3xl md:text-4xl font-extrabold text-neutral-900 dark:text-white tracking-tight">
              {tool.name}
            </h1>

            <p class="mt-2 text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 max-w-2xl leading-relaxed">
              {tool.longDescription}
            </p>

            <!-- Accepted Formats & File Limit Pills -->
            <div class="flex flex-wrap items-center gap-1.5 mt-3.5">
              <span class="text-[11px] font-medium text-neutral-400 dark:text-neutral-500 mr-1">Accepts:</span>
              {tool.acceptedExtensions.map((ext) => (
                <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-mono font-medium bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 border border-neutral-200/60 dark:border-neutral-700/60">
                  {ext}
                </span>
              ))}
              <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-medium bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 border border-neutral-200/60 dark:border-neutral-700/60">
                Max {tool.maxSizeMB} MB
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Tool Interactive Island Slot -->
    <div class="container py-8 sm:py-12 flex-1">
      <slot />
    </div>

    <!-- Bottom Privacy Assurance Banner -->
    <div class="container pb-12">
      <div class="flex items-center gap-3.5 p-4 sm:p-5 rounded-2xl bg-emerald-50/80 dark:bg-emerald-950/30 border border-emerald-200/80 dark:border-emerald-800/60 text-xs sm:text-sm text-emerald-900 dark:text-emerald-300 shadow-2xs">
        <div class="w-8 h-8 rounded-xl bg-emerald-500 text-white flex items-center justify-center flex-shrink-0 shadow-xs">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
              d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
        </div>
        <div>
          <strong class="font-semibold text-emerald-950 dark:text-emerald-200">100% In-Browser Privacy Guarantee:</strong>
          <span class="text-emerald-800 dark:text-emerald-300/90 ml-1">
            Your files are processed directly on your local device CPU. Zero bytes are uploaded to external servers.
          </span>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
