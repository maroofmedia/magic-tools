---
/**
 * ToolLayout.astro — Layout wrapper for individual tool pages
 */
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Breadcrumb from '@/components/common/Breadcrumb.astro';
import { buildToolSchema } from '@/utils/seo';
import type { ToolConfig } from '@/types/index';

interface Props {
  tool: ToolConfig;
}

const { tool } = Astro.props;

const schema = buildToolSchema({
  name: tool.name,
  description: tool.longDescription,
  url: `/tools/${tool.slug}`,
  breadcrumbs: [
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/#tools' },
    { name: tool.name, url: `/tools/${tool.slug}` },
  ],
});

const categoryLabel = tool.category === 'image' 
  ? 'Image Tools' 
  : tool.category === 'spreadsheet' 
  ? 'Spreadsheet Tools' 
  : 'PDF Tools';
---

<BaseLayout
  title={tool.name}
  description={tool.metaDescription}
  canonical={`/tools/${tool.slug}`}
  keywords={`${tool.name.toLowerCase()}, ${tool.slug.replace(/-/g, ' ')}, ${tool.acceptedExtensions.join(', ')}, free online tool`}
  ogImageAlt={`${tool.name} — Free Online Tool`}
  schema={schema}
>
  <Header />

  <main id="main-content" class="pt-14 flex-1 flex flex-col">
    <!-- Breadcrumb bar -->
    <div class="border-b border-neutral-200/80 dark:border-neutral-800/80 bg-white/50 dark:bg-neutral-900/50 glass">
      <div class="container py-2">
        <Breadcrumb
          items={[
            { label: 'Home', href: '/' },
            { label: categoryLabel, href: `/#${tool.category}` },
            { label: tool.name },
          ]}
        />
      </div>
    </div>

    <!-- Tool Header Banner -->
    <div class="border-b border-neutral-200/80 dark:border-neutral-800/80 bg-white/80 dark:bg-neutral-900/80">
      <div class="container py-4 sm:py-5">
        <div class="flex items-start gap-3 sm:gap-4">
          <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center text-xl sm:text-2xl shadow-2xs flex-shrink-0 mt-0.5" role="img" aria-label={tool.name}>
            {tool.icon}
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-1.5 mb-1">
              <span class={`text-[9px] sm:text-[10px] uppercase font-bold tracking-wider px-1.5 py-0.2 rounded ${
                tool.category === 'image' 
                  ? 'bg-purple-50 dark:bg-purple-950/60 text-purple-700 dark:text-purple-300 border border-purple-200/60 dark:border-purple-800/50' 
                  : tool.category === 'spreadsheet'
                  ? 'bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800/50'
                  : 'bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 border border-blue-200/60 dark:border-blue-800/50'
              }`}>
                {tool.category} tool
              </span>
            </div>

            <h1 class="font-display text-lg sm:text-xl md:text-2xl font-bold text-neutral-900 dark:text-white tracking-tight">
              {tool.name}
            </h1>

            <p class="mt-0.5 text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 max-w-2xl leading-snug sm:leading-relaxed">
              {tool.longDescription}
            </p>

            <!-- Formats & Limit Pills -->
            <div class="flex flex-wrap items-center gap-1 mt-2">
              <span class="text-[11px] font-medium text-neutral-400 dark:text-neutral-500 mr-1">Formats:</span>
              {tool.acceptedExtensions.map((ext) => (
                <span class="inline-flex items-center px-1.5 py-0.2 rounded text-[10px] font-mono font-medium bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 border border-neutral-200/60 dark:border-neutral-700/60">
                  {ext}
                </span>
              ))}
              <span class="inline-flex items-center px-1.5 py-0.2 rounded text-[10px] font-medium bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 border border-neutral-200/60 dark:border-neutral-700/60">
                Max {tool.maxSizeMB} MB
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Tool Interactive Workspace -->
    <div class="container py-5 sm:py-7">
      <slot />
    </div>
  </main>

  <Footer />
</BaseLayout>
